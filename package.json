{
  "name": "kairo-labo",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "sync:skills": "node ./scripts/sync-skills.mjs",
    "postinstall": "pnpm sync:skills",
    "check": "pnpm lint && pnpm apps:build && pnpm apps:test",
    "dev": "pnpm gallery",
    "kairo": "tsx ./apps/kairo-cli/src/cli.ts",
    "gallery": "pnpm gallery:sync && turbo run dev --parallel --filter=@kairo-labo/kairo-server --filter=@kairo-labo/kairo-gallery",
    "gallery:sync": "pnpm --filter @kairo-labo/kairo-gallery generate:data",
    "commitlint": "commitlint",
    "apps:build": "turbo run build --filter=@kairo-labo/kairo-*",
    "apps:test": "turbo run test --filter=@kairo-labo/kairo-*",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:staged": "lint-staged",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@types/node": "25.9.2",
    "lint-staged": "17.0.7",
    "simple-git-hooks": "2.13.1",
    "tsx": "4.22.4",
    "turbo": "2.9.17",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "**/*.{js,cjs,mjs,jsx,ts,tsx,json,jsonc,css,html}": "biome check --write"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint:staged",
    "commit-msg": "pnpm commitlint --edit \"$1\""
  },
  "volta": {
    "node": "24.14.0"
  }
}
