{
  "name": "@kairo-labo/kairo-gallery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "pnpm generate:data && tsc --noEmit -p tsconfig.json && vite build",
    "dev": "pnpm generate:data && vite --host 127.0.0.1",
    "generate:data": "tsx ./scripts/generate-kairo-data.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "pnpm generate:data && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@kairo-labo/kairo-core": "workspace:*",
    "@radix-ui/react-slot": "1.2.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.3.0",
    "tsx": "4.22.4",
    "vite": "catalog:"
  }
}
